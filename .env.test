# Testmiljø: E2E-tests (Playwright) og andet, der kører med NODE_ENV=test.
# Next.js og scripts/load-env.ts læser denne fil, når NODE_ENV=test, og læser
# da IKKE .env.local. Dermed rører tests aldrig udviklingsdatabasen.
#
# Filen committes med vilje: den indeholder ingen rigtige hemmeligheder, kun
# lokale testværdier. Personlige overrides lægges i .env.test.local (ignoreres
# af git). Variabler sat i shell/CI vinder altid over filerne.

# SKAL pege på en database, hvis navn ender på "_test" (tjekkes af playwright.config.ts).
# Integrationstests (npm run test:integration) bruger samme server, men databasen
# olklubben_itest (tests/integration/env.mts).
DATABASE_URL="postgresql://postgres@localhost:5432/olklubben_test"
DIRECT_URL="postgresql://postgres@localhost:5432/olklubben_test"

# Kun til test. Bruges aldrig i development eller produktion.
BETTER_AUTH_SECRET="a584CJgeIpMpaYhTVrfpIEOqV6KaUfR6zET1wr62Bg4="
BETTER_AUTH_URL="http://localhost:3100"

# Ingen Google og ingen SMTP i test: mails skrives til .dev-outbox/ (D-024).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# E2E opretter mange brugere fra samme IP: slå rate limiting fra (login, signup,
# glemt password, join-med-kode). Virker kun uden for produktion.
RATE_LIMIT_DISABLED="1"

# E2E læser mails (fx nulstillingslinks) her. Ligger under .dev-outbox/, som git ignorerer.
DEV_OUTBOX_DIR=".dev-outbox/e2e"

# Runde 4: den daglige lukning af afstemninger (/api/cron/close-polls). Kun til test.
CRON_SECRET="itest-cron-secret-0123456789abcdef"

# Feedback (§9.9, D-142): én fast app-admin pr. Playwright-projekt (desktop og
# mobil). E2E opretter selv kontoerne. Integrationstestene sætter deres egen
# app-admin (de mocker appAdminEmails). Kun til test.
APP_ADMIN_EMAILS="e2e-appadmin-desktop@example.test,e2e-appadmin-mobile@example.test"
