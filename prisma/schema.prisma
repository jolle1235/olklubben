// Ølklubben – Prisma schema (datamodel: SPEC §11).
// Prisma 7: the connection URL lives in prisma.config.ts (CLI) and in the
// driver adapter (@prisma/adapter-pg, src/server/db) at runtime, not here.
//
// Conventions (keep them when adding models in later rounds):
//   * Models are PascalCase, fields camelCase. Tables are snake_case plural
//     (@@map) and columns snake_case (@map), so raw SQL never needs quoting.
//   * IDs are UUIDv7 strings generated by Prisma Client (@default(uuid(7))) in a
//     plain text column. Route params are untrusted input: validate them with
//     isValidId() from src/lib/ids.ts before querying (invalid → notFound()).
//     Better Auth runs with advanced.database.generateId = "uuid", so it leaves
//     the id to Prisma as well.
//   * Every timestamp is timestamptz (SPEC §4.6).
//   * CHECK constraints are written as raw SQL in the migrations. Prisma cannot
//     express them and ignores them when diffing, so later `migrate dev` runs
//     keep them. Partial unique indexes use the `partialIndexes` preview
//     feature, so Prisma knows them and never drops them.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth (core tables) ──────────────────────────────────────────────
// Field names must match Better Auth 1.7's schema exactly (its runtime schema
// check compares them with this data model at startup). Better Auth addresses
// the models through the client properties prisma.user, prisma.session,
// prisma.account, prisma.verification and prisma.rateLimit.

model User {
  id            String   @id @default(uuid(7))
  name          String
  /// Always lowercase (Better Auth lowercases on sign-up, sign-in and OAuth).
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// The club `/` sends the user to (SPEC §4.5, §10.1). Ignored when the user
  /// is no longer a member (E15).
  lastActiveClubId String? @map("last_active_club_id")
  lastActiveClub   Club?   @relation("UserLastActiveClub", fields: [lastActiveClubId], references: [id], onDelete: SetNull)

  /// Global nickname (SPEC §9.8, D-011, D-105). 1–40 characters after trim
  /// (CHECK users_nickname_length_check). Null = none; getDisplayName shows it
  /// instead of the name. Written ONLY by src/server/users/mutations.ts. A Better
  /// Auth additionalField with input:false, so /update-user and sign-up refuse it.
  nickname String?

  sessions        Session[]
  accounts        Account[]
  memberships     Membership[]
  invitesCreated  Invite[]            @relation("InviteCreatedBy")
  eventsCreated   Event[]             @relation("EventCreatedBy")
  beersCreated    Beer[]              @relation("BeerCreatedBy")
  beerRatings     BeerRating[]
  placesCreated   Place[]             @relation("PlaceCreatedBy")
  placeOwnerships PlaceOwner[]
  eventHostships  EventHost[]
  songsCreated    Song[]              @relation("SongCreatedBy")
  pollsCreated    Poll[]              @relation("PollCreatedBy")
  pollsClosed     Poll[]              @relation("PollClosedBy")
  pollsCancelled  Poll[]              @relation("PollCancelledBy")
  pollBallots     PollBallot[]
  pollTieChoices  PollTieResolution[] @relation("PollTieChosenBy")
  feedbackCreated Feedback[]          @relation("FeedbackCreatedBy")
  feedbackVotes   FeedbackVote[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7))
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// One row per login method. Email/password users have providerId
/// "credential" (accountId = user id, password = scrypt hash); Google users
/// have providerId "google" (accountId = Google's subject id).
model Account {
  id                    String    @id @default(uuid(7))
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// One-time tokens (password reset, OAuth state). Identifiers are stored as
/// SHA-256 hashes (Better Auth verification.storeIdentifier = "hashed").
model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

/// Better Auth's own rate-limit counters (rateLimit.storage = "database").
/// lastRequest is a Unix timestamp in milliseconds.
model RateLimit {
  id          String @id @default(uuid(7))
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

// ─── App ────────────────────────────────────────────────────────────────────

/// Fixed-window counters for src/server/rate-limit.ts (sign-in, sign-up and
/// password reset via the Better Auth hook, join-with-code; SPEC §4.7).
/// Separate from RateLimit because Better Auth prunes that table by its own
/// windows.
model AppRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("app_rate_limits")
}

enum ClubRole {
  ADMIN
  MEMBER

  @@map("club_role")
}

model Club {
  id          String   @id @default(uuid(7))
  /// 1–60 characters, trimmed (CHECK in the migration).
  name        String
  /// 1–300 characters after trim, or null (CHECK clubs_description_length_check, D-110).
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships     Membership[]
  invites         Invite[]
  lastActiveUsers User[]       @relation("UserLastActiveClub")
  events          Event[]
  beers           Beer[]
  places          Place[]
  songs           Song[]
  polls           Poll[]

  @@map("clubs")
}

/// Rights live only in role (SPEC §5, D-018). Rule "at least one ADMIN per
/// club" is enforced in the domain layer inside a transaction (SPEC §11).
model Membership {
  id        String   @id @default(uuid(7))
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId    String   @map("club_id")
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  role      ClubRole @default(MEMBER)
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Place ownerships in this club (composite FK place_owners(user_id, club_id)
  /// → memberships(user_id, club_id) ON DELETE CASCADE): an owner is always a
  /// member, and the ownership ends with the membership (§7.4, D-096).
  placeOwnerships PlaceOwner[]

  /// Also the target of the composite FK from place_owners.
  @@unique([userId, clubId])
  @@index([clubId])
  @@map("memberships")
}

/// Invitation codes (SPEC §7.3). At most one active (not revoked) code per
/// club. Codes are stored canonical: 8 characters from INVITE_ALPHABET,
/// uppercase, without hyphen (CHECK in the migration).
model Invite {
  id          String    @id @default(uuid(7))
  clubId      String    @map("club_id")
  club        Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  code        String    @unique
  createdById String    @map("created_by_id")
  createdBy   User      @relation("InviteCreatedBy", fields: [createdById], references: [id])
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// [SENERE] Not used yet (SPEC §7.3).
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([clubId], map: "invites_club_id_active_key", where: { revokedAt: null })
  @@index([clubId])
  @@map("invites")
}

// ─── Round 2: events, beers and ratings (SPEC §9.2, §9.5, §11) ──────────────
//
// Who created a row (createdById) and who rated (BeerRating.userId) point at
// User with ON DELETE RESTRICT, like Invite.createdById. Leaving a club only
// deletes the Membership, so events, beers and ratings of former members stay
// (§7.4, E1, Q6: their ratings still count). Deleting a user is [SENERE] and
// is planned as anonymisation (§11 User.deletedAt), not a row delete; RESTRICT
// makes a hard delete fail loudly instead of silently losing club history.

/// A tasting (SPEC §9.2). Round 3: the place is a Place of the same club and
/// the hosts are EventHost rows (D-098). Round 4: pollId links the event a
/// poll created (§9.7.7, D-007); the free-text location_text is gone (TG-032).
/// Lengths (title 1–100, theme ≤ 80, description ≤ 5000) and
/// ends_at > starts_at are CHECK constraints in the migrations.
///
/// clubId takes part in THREE relations (club, place and poll via composite FKs).
/// Write ONLY with unchecked scalar inputs (clubId, placeId, createdById …),
/// never `connect` on club or place.
model Event {
  id          String    @id @default(uuid(7))
  clubId      String    @map("club_id")
  club        Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title       String
  theme       String?
  description String?
  startsAt    DateTime  @map("starts_at") @db.Timestamptz(3)
  /// Optional. Without it the event counts as ongoing until startsAt + 6 h (§9.1).
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(3)
  /// Required (§9.2). Composite FK (place_id, club_id) → places(id, club_id): the
  /// place is in the event's club (D-096). RESTRICT: used places are archived,
  /// never deleted (D-004, D-100).
  placeId     String    @map("place_id")
  place       Place     @relation(fields: [placeId, clubId], references: [id, clubId], onDelete: Restrict)
  createdById String    @map("created_by_id")
  createdBy   User      @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  /// Set when a poll created the event (§9.7.7). UNIQUE = idempotent close (D-007).
  /// Composite (poll_id, club_id) → polls(id, club_id) RESTRICT: same club; polls
  /// are only deleted by deleteClub, after its events (D-130).
  pollId      String?   @unique @map("poll_id")
  poll        Poll?     @relation(fields: [pollId, clubId], references: [id, clubId], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  beers Beer[]
  hosts EventHost[]

  @@index([clubId, startsAt])
  @@index([placeId])
  @@map("events")
}

// ─── Round 3: places, owners and hosts (SPEC §9.2, §9.4, §11) ───────────────
//
// Club isolation in the database (D-096): composite FKs prove that an event's
// place and a place's owner belong to the same club. clubId takes part in two
// relations on Event and PlaceOwner, so write those rows ONLY with unchecked
// scalar inputs (createMany/updateMany or create with plain ids), never with
// `connect`, and never use SetNull on a composite relation (D-073).

/// A place where the club meets (SPEC §9.4), e.g. "Hos Mads". Used places are
/// archived, never deleted (D-100). Lengths (name 1–120, address ≤ 200,
/// description ≤ 1000) and a non-empty name_key are CHECK constraints.
model Place {
  id          String    @id @default(uuid(7))
  clubId      String    @map("club_id")
  club        Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  /// 1–120 (CHECK). Stored cleaned (cleanPlaceName).
  name        String
  /// placeNameKey(name), computed in JS (src/server/domain/places/name.ts). Never empty (CHECK).
  nameKey     String    @map("name_key")
  /// ≤ 200. "Åbn i kort" searches it (D-101).
  address     String?
  /// ≤ 1000, line breaks kept.
  description String?
  createdById String    @map("created_by_id")
  createdBy   User      @relation("PlaceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  owners      PlaceOwner[]
  events      Event[]
  pollOptions PollOption[]

  /// Target of the composite FKs (club isolation in the DB, D-096).
  @@unique([id, clubId])
  /// One ACTIVE place per name key and club (D-095). TRAP (like TG-004): never
  /// findUnique on clubId_nameKey, because it ignores archived_at. Use
  /// findFirst({ where: { clubId, nameKey, archivedAt: null } }).
  @@unique([clubId, nameKey], map: "places_club_id_name_key_active_key", where: { archivedAt: null })
  @@index([clubId])
  @@map("places")
}

/// A member who owns a place (SPEC §9.4): owners become the default hosts.
model PlaceOwner {
  placeId    String     @map("place_id")
  clubId     String     @map("club_id")
  userId     String     @map("user_id")
  place      Place      @relation(fields: [placeId, clubId], references: [id, clubId], onDelete: Cascade)
  /// The owner is a member of the place's club (DB-enforced). The ownership
  /// disappears with the membership (§7.4).
  membership Membership @relation(fields: [userId, clubId], references: [userId, clubId], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([placeId, userId])
  @@index([userId, clubId])
  @@map("place_owners")
}

/// A host of an event (SPEC §9.2, D-098).
model EventHost {
  eventId   String   @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// History (§7.4), so no FK to memberships. RESTRICT like D-072. Membership is
  /// checked at write time under FOR SHARE (src/server/db/locks.ts).
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([eventId, userId])
  @@index([userId])
  @@map("event_hosts")
}

/// A beer in the club's catalogue (SPEC §9.5). App rule (data layer,
/// src/server/beers/mutations.ts): event.clubId = beer.clubId. A composite FK
/// cannot express it here, because ON DELETE SET NULL would also null club_id.
model Beer {
  id          String   @id @default(uuid(7))
  clubId      String   @map("club_id")
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  /// 1–120 characters, trimmed (CHECK in the migration).
  name        String
  /// 0.0–99.9 % (CHECK abv >= 0 AND abv < 100).
  abv         Decimal  @db.Decimal(3, 1)
  /// Deleting the event keeps the beer and its ratings (E13).
  eventId     String?  @map("event_id")
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdById String   @map("created_by_id")
  createdBy   User     @relation("BeerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ratings BeerRating[]

  @@index([clubId, name])
  @@index([eventId])
  @@map("beers")
}

/// One member's rating of one beer (SPEC §9.5). Stored in half points: 2 = 1,0
/// stars … 10 = 5,0 stars (D-003, CHECK value BETWEEN 2 AND 10). The club's
/// average is computed on read, never stored (§3.4).
model BeerRating {
  id        String   @id @default(uuid(7))
  /// Deleting the beer deletes its ratings (E14).
  beerId    String   @map("beer_id")
  beer      Beer     @relation(fields: [beerId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  value     Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([beerId, userId])
  @@index([userId])
  @@map("beer_ratings")
}

// ─── Round 3: the songbook (SPEC §9.6, §11) ─────────────────────────────────

/// A song in the club's songbook (SPEC §9.6). `body` is plain text in the
/// song-text format (src/server/domain/songs/song-text.ts): lyrics, chord lines,
/// [Afsnit] labels, blank line = new stanza. NEVER search or show `body` raw
/// (chord lines such as "Am" are mixed in): use parseSong()/lyricsOnlyLines().
/// Admins write (§5.1), members read. CHECKs in the migration.
model Song {
  id          String   @id @default(uuid(7))
  clubId      String   @map("club_id")
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  /// 1–120 (CHECK). Stored cleaned (cleanSongTitle = cleanSingleLine).
  title       String
  /// songTitleKey(title) = nameKey (D-086/D-095), computed in JS. Unique per club.
  titleKey    String   @map("title_key")
  /// Original performer ("Kim Larsen"). ≤ 120. Null = none.
  artist      String?
  /// Tune it is sung to; shown as "Mel.: …". ≤ 120. Null = none.
  melody      String?
  /// ≤ 20 000 chars, cleanSongText (LF, NFC, leading spaces KEPT).
  body        String
  /// Import provenance: "chordbank:<file name NFC>". Null for songs made in the app.
  /// Written only by scripts/import-songbook.ts; app edits never touch it.
  sourceKey   String?  @map("source_key")
  /// sha256 hex of JSON [title, artist, melody, body] as the importer last wrote
  /// them. If the row no longer hashes to it, an admin edited the song and a
  /// re-import leaves it alone. Only the importer writes it.
  importHash  String?  @map("import_hash")
  createdById String   @map("created_by_id")
  createdBy   User     @relation("SongCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// One song per title per club; the leading club_id also serves club scans.
  @@unique([clubId, titleKey])
  /// Re-import match. Postgres NULLS DISTINCT: app-made songs (NULL) never collide.
  /// Query it with findFirst({ where: { clubId, sourceKey } }).
  @@unique([clubId, sourceKey])
  @@map("songs")
}

// ─── Round 4: polls (SPEC §9.7, §11, D-129 …) ───────────────────────────────
//
// Counts, "har stemt", "alle har stemt" and the winner are COMPUTED (§3.4),
// never stored. Only the manual choice after a tie is stored (PollTieResolution).
// Every writer of a poll holds lockPoll (src/server/db/locks.ts, FOR NO KEY
// UPDATE); see the lock order there. Ballots of polls that are no longer OPEN
// never change (votes are refused, endMembership only deletes OPEN ballots), so
// a recomputed tally of a closed poll is stable.

enum PollStatus {
  OPEN
  AWAITING_DECISION
  CLOSED
  CANCELLED

  @@map("poll_status")
}

enum PollCloseReason {
  DEADLINE
  ALL_VOTED
  MANUAL

  @@map("poll_close_reason")
}

enum PollCategory {
  DATE
  PLACE

  @@map("poll_category")
}

/// "Planlæg ølsmagning" (SPEC §9.7). title/theme/description have the SAME
/// CHECKs as events, so copying them into the event can never fail (§9.7.7).
/// Lifecycle CHECKs in the migration (polls_lifecycle_*).
model Poll {
  id            String           @id @default(uuid(7))
  clubId        String           @map("club_id")
  club          Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  /// 1–100 (CHECK).
  title         String
  /// ≤ 80 (CHECK).
  theme         String?
  /// ≤ 5000 (CHECK), "\n" kept.
  description   String?
  deadline      DateTime         @db.Timestamptz(3)
  status        PollStatus       @default(OPEN)
  /// Set when voting ended (→ AWAITING_DECISION or CLOSED). Kept on a later cancel.
  closeReason   PollCloseReason? @map("close_reason")
  closedAt      DateTime?        @map("closed_at") @db.Timestamptz(3)
  /// Only for closeReason = MANUAL (CHECK).
  closedById    String?          @map("closed_by_id")
  closedBy      User?            @relation("PollClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  cancelledAt   DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  cancelledById String?          @map("cancelled_by_id")
  cancelledBy   User?            @relation("PollCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  createdById   String           @map("created_by_id")
  createdBy     User             @relation("PollCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  options        PollOption[]
  ballots        PollBallot[]
  tieResolutions PollTieResolution[]
  /// 0 or 1 rows: events.poll_id is UNIQUE (D-007). Prisma sees 1:n because the
  /// FK is composite (poll_id, club_id). Read it as events[0].
  events         Event[]

  /// Target of the composite FKs from poll_options and events (D-096 pattern).
  @@unique([id, clubId])
  @@index([clubId, status])
  /// Cron / lazy-close scans.
  @@index([status, deadline])
  @@map("polls")
}

/// A date or a place to vote on (D-005). The options change only while the poll
/// is OPEN and has no ballot (D-153): updatePoll diffs them under lockPoll, and
/// unchanged options keep their ids.
/// clubId takes part in two relations (poll, place): unchecked writes only.
model PollOption {
  id        String       @id @default(uuid(7))
  pollId    String       @map("poll_id")
  clubId    String       @map("club_id")
  poll      Poll         @relation(fields: [pollId, clubId], references: [id, clubId], onDelete: Cascade)
  category  PollCategory
  /// DATE only (CHECK).
  startsAt  DateTime?    @map("starts_at") @db.Timestamptz(3)
  /// PLACE only (CHECK). Composite FK (place_id, club_id) → places(id, club_id):
  /// the place is in the poll's club. RESTRICT: a place that has been in a poll
  /// is archived, never deleted (D-132). DATE rows have place_id NULL, so the
  /// FK is skipped (MATCH SIMPLE).
  placeId   String?      @map("place_id")
  place     Place?       @relation(fields: [placeId, clubId], references: [id, clubId], onDelete: Restrict)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  votes          PollVote[]
  tieResolutions PollTieResolution[]

  /// No duplicate dates (NULLs distinct, so PLACE rows never collide).
  @@unique([pollId, startsAt])
  /// No duplicate places.
  @@unique([pollId, placeId])
  /// Target of the vote and tie-resolution FKs: same poll AND same category.
  @@unique([id, pollId, category])
  /// PlaceUsage counts and the RESTRICT check.
  @@index([placeId])
  @@map("poll_options")
}

/// One ballot per member per poll. Only COMPLETE ballots are ever stored
/// (D-134), so "har stemt" = a ballot exists. userId → users RESTRICT, no FK to
/// memberships: ballots of polls that are no longer OPEN are history (§7.4).
model PollBallot {
  id          String   @id @default(uuid(7))
  pollId      String   @map("poll_id")
  poll        Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// "Ingen af datoerne passer mig". App rule: true ⇒ no DATE votes (TG-052).
  noDateWorks Boolean  @default(false) @map("no_date_works")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  votes PollVote[]

  @@unique([pollId, userId])
  /// Target of PollVote's composite FK.
  @@unique([id, pollId])
  @@index([userId])
  @@map("poll_ballots")
}

/// One tick. Both composite FKs carry poll_id, so option.poll_id = ballot.poll_id
/// is enforced by the database (SPEC §11 listed it as an app rule), and the
/// category must match the option's (D-005).
model PollVote {
  ballotId  String       @map("ballot_id")
  pollId    String       @map("poll_id")
  optionId  String       @map("option_id")
  category  PollCategory
  ballot    PollBallot   @relation(fields: [ballotId, pollId], references: [id, pollId], onDelete: Cascade)
  option    PollOption   @relation(fields: [optionId, pollId, category], references: [id, pollId, category], onDelete: Cascade)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  /// No double tick.
  @@id([ballotId, optionId])
  /// At most one PLACE tick per ballot. TRAP (like TG-004): Prisma generates a
  /// WhereUniqueInput on ballotId from this partial index. Never
  /// findUnique({ where: { ballotId } }).
  @@unique([ballotId], map: "poll_votes_ballot_id_place_key", where: { category: "PLACE" })
  @@index([optionId])
  @@map("poll_votes")
}

/// The manual choice after a tie (D-008). One row per tied category, written
/// in the same tx as the event. The FK proves the option is in this poll AND
/// in this category.
model PollTieResolution {
  pollId         String       @map("poll_id")
  category       PollCategory
  chosenOptionId String       @map("chosen_option_id")
  poll           Poll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  chosenOption   PollOption   @relation(fields: [chosenOptionId, pollId, category], references: [id, pollId, category], onDelete: Cascade)
  chosenById     String       @map("chosen_by_id")
  chosenBy       User         @relation("PollTieChosenBy", fields: [chosenById], references: [id], onDelete: Restrict)
  chosenAt       DateTime     @default(now()) @map("chosen_at") @db.Timestamptz(3)

  @@id([pollId, category])
  @@index([chosenOptionId])
  @@map("poll_tie_resolutions")
}

// ─── Feedback: bug reports and feature wishes (SPEC §9.9, §11, D-141 …) ─────
//
// App-wide, NOT club data (§3.3 exception): no clubId, every logged-in user
// sees every report. The 👍 count is COMPUTED (§3.4): 1 (the author) + the
// FeedbackVote rows, never stored. Only an app-admin (APP_ADMIN_EMAILS, D-142)
// changes status, writes a response or marks a duplicate. CHECKs in the
// migration (feedback_*_check, D-141).

enum FeedbackType {
  BUG
  FEATURE

  @@map("feedback_type")
}

enum FeedbackStatus {
  NEW
  PLANNED
  IN_PROGRESS
  DONE
  WONT_DO
  DUPLICATE

  @@map("feedback_status")
}

/// One report (SPEC §9.9, D-141). title 3–120 and description 10–5000 after
/// btrim (CHECKs); shown as plain text, line breaks kept. pagePath is the page
/// a BUG came from with the club id removed (toFeedbackPagePath, E26, D-143).
/// userAgent and viewportWidth are BUG-only (CHECK) and only ever selected for
/// an app-admin (getFeedbackDetail, D-145). duplicateOfId only with status
/// DUPLICATE (one-way CHECK: SET NULL when the original is deleted keeps the
/// status). createdById SET NULL when the account is deleted: the report stays
/// as "Tidligere bruger" (E27).
model Feedback {
  id            String         @id @default(uuid(7))
  type          FeedbackType
  /// 3–120 after btrim (CHECK), cleaned single line.
  title         String
  /// 10–5000 after btrim (CHECK), "\n" kept.
  description   String         @db.Text
  /// BUG only. Starts with "/", ≤ 200, no club id, query or hash (CHECK + D-143).
  pagePath      String?        @map("page_path")
  /// BUG only, ≤ 500 (CHECK). Read server-side from the request (D-145). App-admin only.
  userAgent     String?        @map("user_agent")
  /// BUG only, 1–20 000 (CHECK). App-admin only.
  viewportWidth Int?           @map("viewport_width")
  status        FeedbackStatus @default(NEW)
  /// The app-admin's short answer, 1–2000 after btrim (CHECK).
  adminResponse String?        @map("admin_response") @db.Text
  /// The original report (status DUPLICATE only, never itself, CHECKs). Never a
  /// chain: the original is never a DUPLICATE (moderateFeedback, D-145).
  duplicateOfId String?        @map("duplicate_of_id")
  duplicateOf   Feedback?      @relation("FeedbackDuplicateOf", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    Feedback[]     @relation("FeedbackDuplicateOf")
  /// Null after the author's account is deleted ("Tidligere bruger", E27).
  createdById   String?        @map("created_by_id")
  createdBy     User?          @relation("FeedbackCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  votes FeedbackVote[]

  /// The list's status filter + newest first, and the agent script.
  @@index([status, createdAt])
  /// "Mine rapporter".
  @@index([createdById])
  /// SET NULL when an original is deleted.
  @@index([duplicateOfId])
  @@map("feedback")
}

/// One 👍 (SPEC §9.9). One per user per report (PK). "Not on your own report"
/// is an app rule, enforced in SQL by the insert itself (setFeedbackVote:
/// INSERT … SELECT … WHERE created_by_id IS DISTINCT FROM the voter, D-145),
/// not by a constraint. Deleting the account deletes its votes (E27).
model FeedbackVote {
  feedbackId String   @map("feedback_id")
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([feedbackId, userId])
  @@index([userId])
  @@map("feedback_votes")
}
