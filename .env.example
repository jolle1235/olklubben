# Ølklubben – miljøvariabler (SPEC §4.8)
#
# Kopiér til .env.local til lokal udvikling:   cp .env.example .env.local
# .env.local committes aldrig. På Vercel sættes værdierne under
# Project → Settings → Environment Variables (Neon-variablerne sættes
# automatisk af Marketplace-integrationen).
#
# Alle variabler valideres med Zod ved opstart i src/env.ts. Mangler en
# påkrævet variabel, stopper appen med en fejl, der nævner den. Tomme værdier
# ("") tæller som "ikke sat".

# ── Database (påkrævet) ─────────────────────────────────────────────────────
# Appens forbindelse. På Neon: den POOLED connection string (host med "-pooler").
DATABASE_URL="postgresql://postgres@localhost:5432/olklubben_dev"
# Direkte (ikke-pooled) forbindelse, som Prisma CLI bruger til migrations.
# KUN til lokal/manuel brug. Valgfri lokalt: mangler den, bruges DATABASE_URL.
# Sæt den ALDRIG i Vercel: dér sætter Neon-integrationen DATABASE_URL_UNPOOLED
# pr. miljø (og pr. Preview-branch), og migrations bruger den. En DIRECT_URL i
# Vercel ville få previews til at migrere produktionsdatabasen, så builds på
# Preview afviser den (src/lib/migration-url.ts).
DIRECT_URL="postgresql://postgres@localhost:5432/olklubben_dev"
# DATABASE_URL_UNPOOLED   # sættes af Neon-integrationen på Vercel, ikke lokalt

# ── Authentication: Better Auth (påkrævet) ──────────────────────────────────
# Tilfældig hemmelighed på mindst 32 tegn. Generér med:  openssl rand -base64 32
# Brug forskellige værdier i development, preview og produktion.
BETTER_AUTH_SECRET=""
# Appens base-URL i det pågældende miljø, uden afsluttende "/".
# Lokalt: http://localhost:3000 · Previews: den URL, der testes på.
# Sæt den IKKE i Vercel Production: dér bruges Vercels VERCEL_PROJECT_PRODUCTION_URL
# (projektets domæne), så invitations- og nulstillingslinks altid peger på
# produktionen og ikke på ét bestemt deploy (D-164).
BETTER_AUTH_URL="http://localhost:3000"

# ── Google-login (valgfrit) ─────────────────────────────────────────────────
# Fra Google Cloud Console → APIs & Services → Credentials (OAuth client ID).
# Registrér redirect-URI'en <BETTER_AUTH_URL>/api/auth/callback/google for både
# localhost og produktion. Begge skal være sat, ellers er Google-login slået fra.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Email via SMTP (valgfrit, midlertidigt Gmail, SPEC §6.4 og D-017) ───────
# SMTP_HOST, SMTP_USER og SMTP_PASSWORD skal alle være sat, ellers regnes email
# som ikke konfigureret: development skriver mails til .dev-outbox/ (D-024), og
# produktion viser "Kontakt en admin i din klub" på "Glemt password".
SMTP_HOST="smtp.gmail.com"
# 465 = SMTPS (TLS fra start). Standard er 465, hvis den ikke er sat.
SMTP_PORT="465"
SMTP_USER=""
# Gmail: et app-password (kræver 2-trinsbekræftelse), IKKE kontoens rigtige password.
SMTP_PASSWORD=""
# Afsender, fx: Ølklubben <olklubben@gmail.com>
EMAIL_FROM=""

# ── Kun udvikling og test (virker ikke i produktion) ─────────────────────────
# Mappe til dev-outboxen (D-024), relativt til projektroden. Standard: .dev-outbox
DEV_OUTBOX_DIR=""
# "1" slår rate limiting fra. Sættes i .env.test (E2E opretter mange brugere
# fra samme IP). Ignoreres, når NODE_ENV=production.
RATE_LIMIT_DISABLED=""
# "1" lader `npm run db:seed` skrive testdata til en database, der ikke er lokal
# (fx en Neon dev-branch). Aldrig mod produktion: seed nægter altid i produktion.
# SEED_ALLOW_REMOTE=""

# ── Daglig lukning af afstemninger (runde 4, SPEC §4.8, §9.7.5) ─────────────
# Vercel Cron kalder /api/cron/close-polls hver nat kl. 04:00 UTC (vercel.json)
# og sender værdien som "Authorization: Bearer <CRON_SECRET>". Mindst 16 tegn.
# Generér med:  openssl rand -hex 32   Sæt den i Vercel (Production). Mangler den,
# svarer ruten 503, og kun lazy close (Overblik, Kalender, afstemningssiden)
# lukker afstemninger. Lokalt er den valgfri.
CRON_SECRET=""

# ── App-admin for feedback (SPEC §9.9, D-142) ───────────────────────────────
# Kommasepareret liste over emails, der må ændre status på fejlrapporter og
# ønsker, skrive svar og markere dubletter. Uafhængig af klubroller: en
# klub-admin er ikke automatisk app-admin. Store/små bogstaver og mellemrum er
# ligegyldige. En post, der ikke er en email, stopper appen ved opstart.
# VIGTIGT: Opret først kontoen med emailen i appen, og sæt den derefter her.
# Oprettelse verificerer ikke emails (D-029), så en adresse, der står her, før
# kontoen findes, kan registreres af hvem som helst.
# Tom = ingen app-admin (produktion skriver en advarsel i loggen ved opstart).
# Til lokal udvikling med seed-brugerne:
#   APP_ADMIN_EMAILS="jesper@example.com"
APP_ADMIN_EMAILS=""

# ── Kommer i senere runder (bruges ikke endnu) ──────────────────────────────
# RESEND_API_KEY=""     # når der kommer et eget domæne (TG-001)
