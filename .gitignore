# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: secrets stay local. .env.example (template) and .env.test
# (test-only values) are committed on purpose.
.env*
!.env.example
!.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma client (generated by `prisma generate`, e.g. on postinstall)
/src/generated/prisma/

# local dev email outbox (D-024)
/.dev-outbox/

# the existing songbook (imported locally by script, SPEC §9.6)
/data/sangbog/

# claude code local state
/.claude/settings.local.json
/.claude/*.lock

# Orkestrators arbejdsfiler (planer, snapshots, dumps) – aldrig commit
.work/

# privat sangbogsmateriale (sangbog-design, trin 0)
*.pdf
*.zip
